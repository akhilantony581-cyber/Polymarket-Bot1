# ============================================================
# Polymarket Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Polymarket CLOB API ---
# Get from: https://docs.polymarket.com
POLYMARKET_PRIVATE_KEY=0xyour_polygon_wallet_private_key
POLYMARKET_API_KEY=your_clob_api_key
POLYMARKET_API_SECRET=your_clob_api_secret
POLYMARKET_API_PASSPHRASE=your_clob_api_passphrase

# --- Polygon Network ---
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# --- Telegram Notifications ---
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chatid
